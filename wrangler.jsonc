{
  // Serves the static shell (frontend/) from Cloudflare's edge. There is no
  // "main" script: this is an assets-only Worker, so every request is answered
  // from frontend/ and nothing runs on the Jetson. The API is separate --
  // frontend/index.html points /api/* at api.bonegraph.org (see API_BASE there).
  // No build step: the app transpiles JSX in the browser via babel.min.js.
  "name": "bonegraph",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./frontend"
  }
}
