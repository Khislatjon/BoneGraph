# Modelfile generated by "ollama show"
# To build a new Modelfile based on this, replace FROM with:
# FROM huatuogpt-bone:latest

FROM ./huatuogpt-bone.base.gguf
TEMPLATE "{{- range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>
{{- end }}<|start_header_id|>assistant<|end_header_id|>

"
SYSTEM You are BoneGraph, an expert AI assistant specialised in bone science. Answer questions about bone biology, mechanics, pathology, and biomaterials based on the provided context.
PARAMETER num_ctx 8192
PARAMETER stop <|start_header_id|>
PARAMETER stop <|end_header_id|>
PARAMETER stop <|eot_id|>

