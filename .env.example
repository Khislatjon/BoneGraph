# Copy this file to .env and fill in your values. Never commit .env to git.

# Semantic Scholar API key (get one free at https://www.semanticscholar.org/product/api)
# Without a key: ~100 requests per 5 minutes shared across all unauthenticated users. With a key: 1 request/s.
SEMANTIC_SCHOLAR_API_KEY=your_key_here

# Your email address for the Unpaywall API — no API key needed, just an email.
# Unpaywall resolves doi.org links and publisher landing pages to direct PDF URLs.
# Rate limit: 100,000 requests/day.  Docs: https://unpaywall.org/products/api
UNPAYWALL_EMAIL=your_email@example.com

# Wiley TDM (Text & Data Mining) token for programmatic PDF access.
# Request one at: https://tdm.wiley.com
WILEY_TDM_TOKEN=your_token_here
